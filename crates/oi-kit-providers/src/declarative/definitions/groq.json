      "name": "openai/gpt-oss-20b",
      "context_limit": 131072,
      "max_tokens": 8192
    },
    {
      "name": "qwen/qwen3.8-27b",
      "context_limit": 131072,
      "max_tokens": 8192
    },
    {
      "name": "openai/gpt-oss-safeguard-20b",
      "context_limit": 131072,
      "max_tokens": 8192
    }
  ],
  "supports_streaming": true,
  "preserves_thinking": false,
  "setup": {
    "category": "model",
