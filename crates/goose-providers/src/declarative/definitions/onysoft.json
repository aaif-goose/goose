    { "name": "deepseek/deepseek-v4.1-flash", "context_limit": 1048576 },
    { "name": "moonshotai/kimi-k3.1-pro", "context_limit": 1048576 },
    { "name": "qwen/qwen3.8-2.4t-a95b", "context_limit": 1048576 }
  ],
  "supports_streaming": true,
  "model_doc_link": "https://api.onysoft.com/models",
  "setup_steps": [
    "Create an account at https://api.onysoft.com/register",
